{
  "name": "brightloop-backend",
  "version": "1.0.0",
  "description": "Backend API for Brightloop Subscription Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "billing:run": "tsx src/jobs/run.ts",
    "test": "vitest run",
    "test:person1": "tsx tests/verify_person_1.ts",
    "test:person2": "tsx tests/verify_person_2.ts && tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "bench": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "zod": "^3.23.8",
    "@brightloop/shared": "*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

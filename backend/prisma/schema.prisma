generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String
  role         Role                 @default(CUSTOMER)
  createdAt    DateTime             @default(now())
  customer     Customer?
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model Customer {
  id            String         @id @default(uuid())
  userId        String         @unique
  companyName   String?
  phone         String?
  address       String?
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Product {
  id                String                  @id @default(uuid())
  name              String
  type              String
  salesPrice        Int
  costPrice         Int
  notes             String?
  active            Boolean                 @default(true)
  variants          ProductVariant[]
  discounts         DiscountProduct[]
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
}

model ProductVariant {
  id                String                  @id @default(uuid())
  productId         String
  attribute         String
  value             String
  extraPrice        Int                     @default(0)
  product           Product                 @relation(fields: [productId], references: [id])
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id            String              @id @default(uuid())
  name          String
  price         Int
  billingPeriod BillingPeriod
  minQuantity   Int                 @default(1)
  startDate     DateTime
  endDate       DateTime?
  autoClose     Boolean             @default(false)
  closable      Boolean             @default(true)
  pausable      Boolean             @default(false)
  renewable     Boolean             @default(true)
  templates     QuotationTemplate[]
  subscriptions Subscription[]
}

model Tax {
  id                String             @id @default(uuid())
  name              String
  rateBps           Int
  active            Boolean            @default(true)
  subscriptionLines SubscriptionLine[]
}

model Discount {
  id            String                 @id @default(uuid())
  name          String
  type          DiscountType
  value         Int
  minPurchase   Int?
  minQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  timesUsed     Int                    @default(0)
  scope         DiscountScope
  products      DiscountProduct[]
  subscriptions SubscriptionDiscount[]
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([discountId, productId])
}

model QuotationTemplate {
  id           String                  @id @default(uuid())
  name         String
  validityDays Int
  planId       String
  plan         Plan                    @relation(fields: [planId], references: [id])
  lines        QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
}

model Subscription {
  id                  String                 @id @default(uuid())
  number              String                 @unique
  customerId          String
  planId              String
  status              SubscriptionStatus     @default(DRAFT)
  startDate           DateTime
  expiryDate          DateTime?
  quotationExpiryDate DateTime?
  paymentTermDays     Int                    @default(0)
  nextInvoiceDate     DateTime?
  pausedAt            DateTime?
  renewedFromId       String?
  renewedFrom         Subscription?          @relation("SubscriptionRenewals", fields: [renewedFromId], references: [id])
  renewals            Subscription[]         @relation("SubscriptionRenewals")
  createdAt           DateTime               @default(now())
  customer            Customer               @relation(fields: [customerId], references: [id])
  plan                Plan                   @relation(fields: [planId], references: [id])
  lines               SubscriptionLine[]
  invoices            Invoice[]
  discounts           SubscriptionDiscount[]

  @@index([status, nextInvoiceDate])
  @@index([customerId])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Int
  taxId          String?
  amount         Int
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  tax            Tax?            @relation(fields: [taxId], references: [id])
}

model SubscriptionDiscount {
  subscriptionId String
  discountId     String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  discount       Discount     @relation(fields: [discountId], references: [id])

  @@id([subscriptionId, discountId])
}

model Invoice {
  id              String        @id @default(uuid())
  number          String        @unique
  subscriptionId  String
  customerId      String
  customerName    String?
  customerAddress String?
  periodStart     DateTime
  periodEnd       DateTime
  status          InvoiceStatus @default(DRAFT)
  subtotal        Int
  discountTotal   Int           @default(0)
  taxTotal        Int
  total           Int
  amountPaid      Int           @default(0)
  issueDate       DateTime
  dueDate         DateTime
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  lines           InvoiceLine[]
  payments        Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Int
  discountAmount Int     @default(0)
  taxRateBps     Int     @default(0)
  taxAmount      Int     @default(0)
  amount         Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  method    PaymentMethod
  amount    Int
  paidOn    DateTime
  note      String?
  createdAt DateTime      @default(now())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([paidOn])
}

model Counter {
  key   String @id
  value Int    @default(0)
}
